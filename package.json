{
  "name": "grabazo",
  "version": "1.1.0",
  "private": true,
  "description": "Grabazo: grabación de pantalla, cámara y anotaciones en Chrome, con el celular como control remoto, teleprompter y cámara.",
  "author": "Miguel Mogrovejo",
  "type": "module",
  "scripts": {
    "serve": "python3 -m http.server 8769",
    "build": "./scripts/build.sh",
    "build:crx": "./scripts/build.sh --crx",
    "textos": "python3 scripts/textos.py",
    "icons": "python3 scripts/render.py icons",
    "test:e2e": "node test/e2e.mjs",
    "test:estudio": "node test/estudio.mjs",
    "store:capture": "node scripts/capture-store.mjs",
    "store:images": "python3 scripts/render.py store",
    "presentacion": "python3 scripts/presentacion.py",
    "landing": "./scripts/landing.sh"
  },
  "devDependencies": {
    "puppeteer": "^25.14.0"
  }
}
