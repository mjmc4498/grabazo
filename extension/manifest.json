{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Grabazo",
  "description": "__MSG_extDescription__",
  "version": "1.1.0",
  "author": "Miguel Mogrovejo",
  "homepage_url": "https://mjmc4498.github.io/grabazo/",
  "default_locale": "es",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["activeTab", "desktopCapture", "downloads", "offscreen", "scripting", "storage", "tabCapture", "unlimitedStorage"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "web_accessible_resources": [
    {
      "resources": ["camara.html"],
      "matches": ["https://*/*", "http://*/*"],
      "use_dynamic_url": true
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+G" },
      "description": "__MSG_cmdOpen__"
    },
    "toggle-recording": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "__MSG_cmdRecord__"
    },
    "toggle-pause": {
      "suggested_key": { "default": "Alt+Shift+K" },
      "description": "__MSG_cmdPause__"
    },
    "toggle-draw": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "__MSG_cmdDraw__"
    },
    "toggle-zoom": { "description": "__MSG_cmdZoom__" },
    "toggle-spotlight": { "description": "__MSG_cmdSpotlight__" },
    "toggle-mic": { "description": "__MSG_cmdMic__" },
    "toggle-camera": { "description": "__MSG_cmdCamera__" },
    "toggle-toolbar": { "description": "__MSG_cmdToolbar__" }
  }
}
